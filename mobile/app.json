{
  "expo": {
    "name": "XCash",
    "slug": "xcash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "sdkVersion": "54.0.0",
    "newArchEnabled": true,
    "scheme": "xcash",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#7C3AED"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "com.xcash.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.xcash.mobile",
      "supportsTablet": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c239a784-edf2-4d08-9760-a793af669226"
      }
    },
    "owner": "aialamin"
  }
}
